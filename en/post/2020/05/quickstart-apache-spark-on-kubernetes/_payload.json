:56},"all",{"type":28,"value":58}," the ",{"type":22,"tag":44,"props":60,"children":61},{},[62],{"type":28,"value":63},"major Clouds",{"type":28,"value":65},".\n",{"type":22,"tag":67,"props":68,"children":72},"a",{"href":69,"rel":70},"https:\u002F\u002Fcloud.google.com\u002Fkubernetes-engine\u002F",[71],"nofollow",[73],{"type":28,"value":74},"[1]",{"type":22,"tag":67,"props":76,"children":79},{"href":77,"rel":78},"https:\u002F\u002Faws.amazon.com\u002Feks\u002F",[71],[80],{"type":28,"value":81},"[2]",{"type":22,"tag":67,"props":83,"children":86},{"href":84,"rel":85},"https:\u002F\u002Fdocs.microsoft.com\u002Fen-us\u002Fazure\u002Faks\u002F",[71],[87],{"type":28,"value":88},"[3]",{"type":28,"value":90}," (including\n",{"type":22,"tag":67,"props":92,"children":95},{"href":93,"rel":94},"https:\u002F\u002Fwww.digitalocean.com\u002Fproducts\u002Fkubernetes\u002F",[71],[96],{"type":28,"value":97},"Digital Ocean",{"type":28,"value":99}," and\n",{"type":22,"tag":67,"props":101,"children":104},{"href":102,"rel":103},"https:\u002F\u002Fwww.alibabacloud.com\u002Fproduct\u002Fkubernetes",[71],[105],{"type":28,"value":106},"Alibaba",{"type":28,"value":108},").",{"type":22,"tag":38,"props":110,"children":111},{},[112,114,119,121,128,130,137],{"type":28,"value":113},"With this popularity came various implementations and ",{"type":22,"tag":44,"props":115,"children":116},{},[117],{"type":28,"value":118},"use-cases",{"type":28,"value":120}," of\nthe orchestrator, among them the execution of ",{"type":22,"tag":67,"props":122,"children":125},{"href":123,"rel":124},"https:\u002F\u002Fkubernetes.io\u002Fdocs\u002Ftutorials\u002Fstateful-application\u002F",[71],[126],{"type":28,"value":127},"Stateful\napplications",{"type":28,"value":129},"\nincluding ",{"type":22,"tag":67,"props":131,"children":134},{"href":132,"rel":133},"https:\u002F\u002Fvitess.io\u002Fzh\u002Fdocs\u002Fget-started\u002Fkubernetes\u002F",[71],[135],{"type":28,"value":136},"databases using containers",{"type":28,"value":138},".",{"type":22,"tag":38,"props":140,"children":141},{},[142,144,151],{"type":28,"value":143},"What would be the motivation to host an orchestrated database? That's\na great question. But let's focus on the ",{"type":22,"tag":67,"props":145,"children":148},{"href":146,"rel":147},"https:\u002F\u002Fgithub.com\u002FGoogleCloudPlatform\u002Fspark-on-k8s-operator\u002Fblob\u002Fmaster\u002Fdocs\u002Fdesign.md",[71],[149],{"type":28,"value":150},"Spark Operator",{"type":28,"value":152},"\nrunning workloads on Kubernetes.",{"type":22,"tag":38,"props":154,"children":155},{},[156,158,165,167,172,174,181,183,190,192,199],{"type":28,"value":157},"A native Spark Operator ",{"type":22,"tag":67,"props":159,"children":162},{"href":160,"rel":161},"https:\u002F\u002Fgithub.com\u002Fkubernetes\u002Fkubernetes\u002Fissues\u002F34377",[71],[163],{"type":28,"value":164},"idea came out",{"type":28,"value":166},"\nin 2016, before that you couldn't run Spark jobs natively except\nsome ",{"type":22,"tag":44,"props":168,"children":169},{},[170],{"type":28,"value":171},"hacky alternatives",{"type":28,"value":173},", like ",{"type":22,"tag":67,"props":175,"children":178},{"href":176,"rel":177},"https:\u002F\u002Fkubernetes.io\u002Fblog\u002F2016\u002F03\u002Fusing-spark-and-zeppelin-to-process-big-data-on-kubernetes\u002F",[71],[179],{"type":28,"value":180},"running Apache Zeppelin",{"type":28,"value":182},"\ninside Kubernetes or creating your ",{"type":22,"tag":67,"props":184,"children":187},{"href":185,"rel":186},"https:\u002F\u002Fgithub.com\u002Fkubernetes\u002Fexamples\u002Ftree\u002Fmaster\u002Fstaging\u002Fspark",[71],[188],{"type":28,"value":189},"Apache Spark cluster inside\nKubernetes (from the official Kubernetes organization on GitHub)",{"type":28,"value":191},"\nreferencing the ",{"type":22,"tag":67,"props":193,"children":196},{"href":194,"rel":195},"http:\u002F\u002Fspark.apache.org\u002Fdocs\u002Flatest\u002Fspark-standalone.html",[71],[197],{"type":28,"value":198},"Spark workers in Stand-alone mode",{"type":28,"value":138},{"type":22,"tag":38,"props":201,"children":202},{},[203,205,212],{"type":28,"value":204},"However, the native execution would be far more interesting for taking\nadvantage of ",{"type":22,"tag":67,"props":206,"children":209},{"href":207,"rel":208},"https:\u002F\u002Fkubernetes.io\u002Fdocs\u002Fconcepts\u002Fscheduling-eviction\u002Fkube-scheduler\u002F",[71],[210],{"type":28,"value":211},"Kubernetes Scheduler",{"type":28,"value":213},"\nresponsible for taking action of allocating resources, giving\nelasticity and an simpler interface to manage Apache Spark workloads.",{"type":22,"tag":38,"props":215,"children":216},{},[217,219,226,228,235,237,244],{"type":28,"value":218},"Considering that, ",{"type":22,"tag":67,"props":220,"children":223},{"href":221,"rel":222},"https:\u002F\u002Fissues.apache.org\u002Fjira\u002Fbrowse\u002FSPARK-18278",[71],[224],{"type":28,"value":225},"Apache Spark Operator development got attention",{"type":28,"value":227},",\nmerged and released into ",{"type":22,"tag":67,"props":229,"children":232},{"href":230,"rel":231},"https:\u002F\u002Fspark.apache.org\u002Freleases\u002Fspark-release-2-3-0.html",[71],[233],{"type":28,"value":234},"Spark version 2.3.0",{"type":28,"value":236},"\nlaunched in ",{"type":22,"tag":67,"props":238,"children":241},{"href":239,"rel":240},"https:\u002F\u002Fspark.apache.org\u002Fnews\u002Findex.html",[71],[242],{"type":28,"value":243},"February, 2018",{"type":28,"value":138},{"type":22,"tag":38,"props":246,"children":247},{},[248,250],{"type":28,"value":249},"If you're eager for reading more regarding the Apache Spark proposal,\nyou can head to the ",{"type":22,"tag":67,"props":251,"children":254},{"href":252,"rel":253},"https:\u002F\u002Fdocs.google.com\u002Fdocument\u002Fd\u002F1_bBzOZ8rKiOSjQg78DXOA3ZBIo_KkDJjqxVuq0yXdew\u002Fedit#heading=h.9bhogel14x0y",[71],[255],{"type":28,"value":256},"design document published in Google Docs.",{"type":22,"tag":31,"props":258,"children":260},{"id":259},"why-kubernetes",[261],{"type":28,"value":262},"Why Kubernetes?",{"type":22,"tag":38,"props":264,"children":265},{},[266,268,275,277,283,289,295],{"type":28,"value":267},"As companies are currently seeking to ",{"type":22,"tag":67,"props":269,"children":272},{"href":270,"rel":271},"https:\u002F\u002Fwww.cio.com\u002Farticle\u002F3211428\u002Fwhat-is-digital-transformation-a-necessary-disruption.html",[71],[273],{"type":28,"value":274},"reinvent themselves through the\nwidely spoken digital transformation",{"type":28,"value":276},"\nin order for them to be competitive and, above all, to survive in an\nincreasingly dynamic market, it is common to see approaches that\ninclude Big Data, Artificial Intelligence and Cloud Computing\n",{"type":22,"tag":67,"props":278,"children":281},{"href":279,"rel":280},"https:\u002F\u002Fwww.zdnet.com\u002Farticle\u002Fhow-to-use-cloud-computing-and-big-data-to-support-digital-transformation\u002F",[71],[282],{"type":28,"value":74},{"type":22,"tag":67,"props":284,"children":287},{"href":285,"rel":286},"https:\u002F\u002Fdigitalhealth.london\u002Fcloud-big-data-ai-lead-nhs-digital-transformation\u002F",[71],[288],{"type":28,"value":81},{"type":22,"tag":67,"props":290,"children":293},{"href":291,"rel":292},"https:\u002F\u002Fwww.ibm.com\u002Fblogs\u002Fcloud-computing\u002F2018\u002F11\u002F05\u002Fguiding-framework-digital-transformation-garage\u002F",[71],[294],{"type":28,"value":88},{"type":28,"value":138},{"type":22,"tag":38,"props":297,"children":298},{},[299,301,308,310,317],{"type":28,"value":300},"An interesting comparison between the benefits of using Cloud Computing in the\ncontext of Big Data instead of On-premises' servers can be read at ",{"type":22,"tag":67,"props":302,"children":305},{"href":303,"rel":304},"https:\u002F\u002Fdatabricks.com\u002Fblog\u002F2017\u002F05\u002F31\u002Ftop-5-reasons-for-choosing-s3-over-hdfs.html",[71],[306],{"type":28,"value":307},"Databricks\nblog",{"type":28,"value":309},",\nwhich is the company ",{"type":22,"tag":67,"props":311,"children":314},{"href":312,"rel":313},"https:\u002F\u002Fwww.washingtonpost.com\u002Fnews\u002Fthe-switch\u002Fwp\u002F2016\u002F06\u002F09\u002Fthis-is-where-the-real-action-in-artificial-intelligence-takes-place\u002F",[71],[315],{"type":28,"value":316},"founded by the creators of Apache Spark",{"type":28,"value":138},{"type":22,"tag":38,"props":319,"children":320},{},[321,323,330,332,339,341,348,350,357],{"type":28,"value":322},"As we see a widespread adoption of Cloud Computing (even by companies\nthat would be able to afford the hardware and run on-premises), we\nnotice that most of these Cloud implementations don't have an ",{"type":22,"tag":67,"props":324,"children":327},{"href":325,"rel":326},"https:\u002F\u002Fhadoop.apache.org\u002F",[71],[328],{"type":28,"value":329},"Apache\nHadoop",{"type":28,"value":331}," since the Data Teams (BI\u002FData\nScience\u002FAnalytics) increasingly choose to use tools like ",{"type":22,"tag":67,"props":333,"children":336},{"href":334,"rel":335},"https:\u002F\u002Fcloud.google.com\u002Fbigquery\u002F",[71],[337],{"type":28,"value":338},"Google\nBigQuery",{"type":28,"value":340}," or ",{"type":22,"tag":67,"props":342,"children":345},{"href":343,"rel":344},"https:\u002F\u002Faws.amazon.com\u002Fredshift\u002F",[71],[346],{"type":28,"value":347},"AWS Redshift",{"type":28,"value":349},".\nTherefore, it doesn't make sense to spin-up a Hadoop with the only intention to\nuse ",{"type":22,"tag":67,"props":351,"children":354},{"href":352,"rel":353},"https:\u002F\u002Fhortonworks.com\u002Fapache\u002Fyarn\u002F",[71],[355],{"type":28,"value":356},"YARN",{"type":28,"value":358}," as the resources manager.",{"type":22,"tag":38,"props":360,"children":361},{},[362,364,371,372,379],{"type":28,"value":363},"An alternative is the use of Hadoop cluster providers such as ",{"type":22,"tag":67,"props":365,"children":368},{"href":366,"rel":367},"https:\u002F\u002Fcloud.google.com\u002Fdataproc",[71],[369],{"type":28,"value":370},"Google\nDataProc",{"type":28,"value":340},{"type":22,"tag":67,"props":373,"children":376},{"href":374,"rel":375},"https:\u002F\u002Faws.amazon.com\u002Femr\u002F",[71],[377],{"type":28,"value":378},"AWS EMR",{"type":28,"value":380},"\nfor the creation of ephemeral clusters. Just to name a few options.",{"type":22,"tag":38,"props":382,"children":383},{},[384,386,393],{"type":28,"value":385},"To better understand the design of Spark Operator, the doc from ",{"type":22,"tag":67,"props":387,"children":390},{"href":388,"rel":389},"https:\u002F\u002Fgithub.com\u002FGoogleCloudPlatform\u002Fspark-on-k8s-operatoR\u002Fblob\u002Fmaster\u002Fdocs\u002Fdesign.md#the-crd-controller",[71],[391],{"type":28,"value":392},"GCP on GitHub",{"type":28,"value":394},"\nis a no-brainer.",{"type":22,"tag":23,"props":396,"children":398},{"id":397},"lets-get-hands-on",[399],{"type":28,"value":400},"Let's get hands-on!",{"type":22,"tag":31,"props":402,"children":404},{"id":403},"warming-up-the-engine",[405],{"type":28,"value":406},"Warming up the engine",{"type":22,"tag":38,"props":408,"children":409},{},[410],{"type":28,"value":411},"Now that the word has been spread, let's get our hands on it to show\nthe engine running. For that, let's use:",{"type":22,"tag":413,"props":414,"children":415},"ul",{},[416,438,451,473],{"type":22,"tag":417,"props":418,"children":419},"li",{},[420,427,429,436],{"type":22,"tag":67,"props":421,"children":424},{"href":422,"rel":423},"https:\u002F\u002Fwww.docker.com\u002F",[71],[425],{"type":28,"value":426},"Docker",{"type":28,"value":428}," as the container engine for\nKubernetes ",{"type":22,"tag":67,"props":430,"children":433},{"href":431,"rel":432},"https:\u002F\u002Fdocs.docker.com\u002Finstall\u002F",[71],[434],{"type":28,"value":435},"(installation guide)",{"type":28,"value":437},";",{"type":22,"tag":417,"props":439,"children":440},{},[441,443,449],{"type":28,"value":442},"Minikube ",{"type":22,"tag":67,"props":444,"children":447},{"href":445,"rel":446},"https:\u002F\u002Fkubernetes.io\u002Fdocs\u002Ftasks\u002Ftools\u002Finstall-minikube\u002F",[71],[448],{"type":28,"value":435},{"type":28,"value":450},"\nto facilitate the provisioning of the Kubernetes (yes, it will be\na local execution);",{"type":22,"tag":417,"props":452,"children":453},{},[454,456,463,465,472],{"type":28,"value":455},"For interaction with the Kubernetes API it is necessary to have\n",{"type":22,"tag":457,"props":458,"children":460},"code",{"className":459},[],[461],{"type":28,"value":462},"kubectl",{"type":28,"value":464}," installed, ",{"type":22,"tag":67,"props":466,"children":469},{"href":467,"rel":468},"https:\u002F\u002Fkubernetes.io\u002Fdocs\u002Ftasks\u002Ftools\u002Finstall-kubectl\u002F",[71],[470],{"type":28,"value":471},"if you don't have it, follow instructions\nhere",{"type":28,"value":138},{"type":22,"tag":417,"props":474,"children":475},{},[476,478],{"type":28,"value":477},"a compiled version of Apache Spark larger than 2.3.0.\n",{"type":22,"tag":479,"props":480,"children":481},"ol",{},[482,503],{"type":22,"tag":417,"props":483,"children":484},{},[485,487,494,496,501],{"type":28,"value":486},"you can either compile ",{"type":22,"tag":67,"props":488,"children":491},{"href":489,"rel":490},"https:\u002F\u002Fgithub.com\u002Fapache\u002Fspark",[71],[492],{"type":28,"value":493},"source code",{"type":28,"value":495},",\nwhich will took ",{"type":22,"tag":44,"props":497,"children":498},{},[499],{"type":28,"value":500},"some hours",{"type":28,"value":502}," to finish, or",{"type":22,"tag":417,"props":504,"children":505},{},[506,508,515],{"type":28,"value":507},"download a compiled version ",{"type":22,"tag":67,"props":509,"children":512},{"href":510,"rel":511},"https:\u002F\u002Fspark.apache.org\u002Fdownloads.html",[71],[513],{"type":28,"value":514},"here",{"type":28,"value":516},"\n(recommended).",{"type":22,"tag":38,"props":518,"children":519},{},[520,522,528],{"type":28,"value":521},"Once the necessary tools are installed, it's necessary to\ninclude Apache Spark path in ",{"type":22,"tag":457,"props":523,"children":525},{"className":524},[],[526],{"type":28,"value":527},"PATH",{"type":28,"value":529}," environment variable, to ease the\ninvocation of Apache Spark executables. Simply run:",{"type":22,"tag":531,"props":532,"children":537},"pre",{"code":533,"language":534,"meta":7,"className":535},"export PATH=${PATH}:\u002Fpath\u002Fto\u002Fapache-spark-X.Y.Z\u002Fbin\n","bash",[536],"language-bash",[538],{"type":22,"tag":457,"props":539,"children":540},{"__ignoreMap":7},[541],{"type":28,"value":533},{"type":22,"tag":31,"props":543,"children":545},{"id":544},"creating-the-minikube-cluster",[546],{"type":28,"value":547},"Creating the Minikube \"cluster\"",{"type":22,"tag":38,"props":549,"children":550},{},[551,553,559,561,568,570,576],{"type":28,"value":552},"At last, to have a Kubernetes \"cluster\" we will start a ",{"type":22,"tag":457,"props":554,"children":556},{"className":555},[],[557],{"type":28,"value":558},"minikube",{"type":28,"value":560},"\nwith the intention of running an example from ",{"type":22,"tag":67,"props":562,"children":565},{"href":563,"rel":564},"https:\u002F\u002Fgithub.com\u002Fapache\u002Fspark\u002Fblob\u002Fmaster\u002Fexamples\u002Fsrc\u002Fmain\u002Fscala\u002Forg\u002Fapache\u002Fspark\u002Fexamples\u002FSparkPi.scala",[71],[566],{"type":28,"value":567},"Spark\nrepository",{"type":28,"value":569},"\ncalled ",{"type":22,"tag":457,"props":571,"children":573},{"className":572},[],[574],{"type":28,"value":575},"SparkPi",{"type":28,"value":577}," just as a demonstration.",{"type":22,"tag":531,"props":579,"children":582},{"code":580,"language":534,"meta":7,"className":581},"minikube start --cpus=2 \\\n    --memory=4g\n",[536],[583],{"type":22,"tag":457,"props":584,"children":585},{"__ignoreMap":7},[586],{"type":28,"value":580},{"type":22,"tag":31,"props":588,"children":590},{"id":589},"building-the-docker-image",[591],{"type":28,"value":592},"Building the Docker image",{"type":22,"tag":38,"props":594,"children":595},{},[596],{"type":28,"value":597},"Let's use the Minikube Docker daemon to not depend on an external registry (and\nonly generate Docker image layers on the VM, facilitating garbage disposal\nlater). Minikube has a wrapper that makes our life easier:",{"type":22,"tag":531,"props":599,"children":602},{"code":600,"language":534,"meta":7,"className":601},"eval $(minikube docker-env)\n",[536],[603],{"type":22,"tag":457,"props":604,"children":605},{"__ignoreMap":7},[606],{"type":28,"value":600},{"type":22,"tag":38,"props":608,"children":609},{},[610,612,619,621,626],{"type":28,"value":611},"After having the daemon environment variables configured, we need a\nDocker image to run the jobs. There is a ",{"type":22,"tag":67,"props":613,"children":616},{"href":614,"rel":615},"https:\u002F\u002Fgithub.com\u002Fapache\u002Fspark\u002Fblob\u002Fmaster\u002Fbin\u002Fdocker-image-tool.sh",[71],[617],{"type":28,"value":618},"shell script in the Spark\nrepository",{"type":28,"value":620},"\nto help with this. Considering that our ",{"type":22,"tag":457,"props":622,"children":624},{"className":623},[],[625],{"type":28,"value":527},{"type":28,"value":627}," was properly\nconfigured, just run:",{"type":22,"tag":531,"props":629,"children":632},{"code":630,"language":534,"meta":7,"className":631},"docker-image-tool.sh -m -t latest build\n",[536],[633],{"type":22,"tag":457,"props":634,"children":635},{"__ignoreMap":7},[636],{"type":28,"value":630},{"type":22,"tag":38,"props":638,"children":639},{},[640,645,647,653],{"type":22,"tag":44,"props":641,"children":642},{},[643],{"type":28,"value":644},"FYI:",{"type":28,"value":646}," The ",{"type":22,"tag":457,"props":648,"children":650},{"className":649},[],[651],{"type":28,"value":652},"-m",{"type":28,"value":654}," parameter here indicates a minikube build.",{"type":22,"tag":38,"props":656,"children":657},{},[658,660,667],{"type":28,"value":659},"Let's take the highway to execute SparkPi, using the same command\nthat would be used for a Hadoop Spark cluster ",{"type":22,"tag":67,"props":661,"children":664},{"href":662,"rel":663},"https:\u002F\u002Fspark.apache.org\u002Fdocs\u002Flatest\u002Fsubmitting-applications.html",[71],[665],{"type":28,"value":666},"spark-submit",{"type":28,"value":138},{"type":22,"tag":38,"props":669,"children":670},{},[671,673,680,682,689],{"type":28,"value":672},"However, Spark Operator supports defining jobs in the \"Kubernetes\ndialect\" using ",{"type":22,"tag":67,"props":674,"children":677},{"href":675,"rel":676},"https:\u002F\u002Fkubernetes.io\u002Fdocs\u002Fconcepts\u002Fextend-kubernetes\u002Fapi-extension\u002Fcustom-resources\u002F",[71],[678],{"type":28,"value":679},"CRD",{"type":28,"value":681},",\n",{"type":22,"tag":67,"props":683,"children":686},{"href":684,"rel":685},"https:\u002F\u002Fgithub.com\u002FGoogleCloudPlatform\u002Fspark-on-k8s-operator\u002Ftree\u002Fmaster\u002Fexamples",[71],[687],{"type":28,"value":688},"here are some examples",{"type":28,"value":690}," - for later.",{"type":22,"tag":23,"props":692,"children":694},{"id":693},"fire-in-the-hole",[695],{"type":28,"value":696},"Fire in the hole!",{"type":22,"tag":38,"props":698,"children":699},{},[700],{"type":28,"value":701},"Mid the gap between the Scala version and .jar when you're\nparameterizing with your Apache Spark version:",{"type":22,"tag":531,"props":703,"children":706},{"code":704,"language":534,"meta":7,"className":705},"spark-submit --master k8s:\u002F\u002Fhttps:\u002F\u002F$(minikube ip):8443 \\\n    --deploy-mode cluster \\\n    --name spark-pi \\\n    --class org.apache.spark.examples.SparkPi \\\n    --conf spark.executor.instances=2 \\\n    --executor-memory 1024m \\\n    --conf spark.kubernetes.container.image=spark:latest \\\n    local:\u002F\u002F\u002Fopt\u002Fspark\u002Fexamples\u002Fjars\u002Fspark-examples_2.11-X.Y.Z.jar # here\n",[536],[707],{"type":22,"tag":457,"props":708,"children":709},{"__ignoreMap":7},[710],{"type":28,"value":704},{"type":22,"tag":38,"props":712,"children":713},{},[714],{"type":28,"value":715},"What's new is:",{"type":22,"tag":413,"props":717,"children":718},{},[719,754],{"type":22,"tag":417,"props":720,"children":721},{},[722,728,730,736,738,744,746,753],{"type":22,"tag":457,"props":723,"children":725},{"className":724},[],[726],{"type":28,"value":727},"--master",{"type":28,"value":729},": Accepts a prefix ",{"type":22,"tag":457,"props":731,"children":733},{"className":732},[],[734],{"type":28,"value":735},"k8s:\u002F\u002F",{"type":28,"value":737}," in the URL, for the\nKubernetes master API endpoint, exposed by the command\n",{"type":22,"tag":457,"props":739,"children":741},{"className":740},[],[742],{"type":28,"value":743},"https:\u002F\u002F$(minikube ip):8443",{"type":28,"value":745},". BTW, in case you want to\nknow, it's a ",{"type":22,"tag":67,"props":747,"children":750},{"href":748,"rel":749},"https:\u002F\u002Fwww.gnu.org\u002Fsoftware\u002Fbash\u002Fmanual\u002Fhtml_node\u002FCommand-Substitution.html",[71],[751],{"type":28,"value":752},"shell command substitution",{"type":28,"value":437},{"type":22,"tag":417,"props":755,"children":756},{},[757,763],{"type":22,"tag":457,"props":758,"children":760},{"className":759},[],[761],{"type":28,"value":762},"--conf spark.kubernetes.container.image=",{"type":28,"value":764},": Configures the Docker\nimage to run in Kubernetes.",{"type":22,"tag":38,"props":766,"children":767},{},[768],{"type":28,"value":769},"Sample output:",{"type":22,"tag":531,"props":771,"children":773},{"code":772},"...\n\n19\u002F08\u002F22 11:59:09 INFO LoggingPodStatusWatcherImpl: State changed,\nnew state: pod name: spark-pi-1566485909677-driver namespace: default\nlabels: spark-app-selector -> spark-20477e803e7648a59e9bcd37394f7f60,\nspark-role -> driver pod uid: c789c4d2-27c4-45ce-ba10-539940cccb8d\ncreation time: 2019-08-22T14:58:30Z service account name: default\nvolumes: spark-local-dir-1, spark-conf-volume, default-token-tj7jn\nnode name: minikube start time: 2019-08-22T14:58:30Z container\nimages: spark:docker phase: Succeeded status:\n[ContainerStatus(containerID=docker:\u002F\u002Fe044d944d2ebee2855cd2b993c62025d\n6406258ef247648a5902bf6ac09801cc, image=spark:docker,\nimageID=docker:\u002F\u002Fsha256:86649110778a10aa5d6997d1e3d556b35454e9657978f3\na87de32c21787ff82f, lastState=ContainerState(running=null,\nterminated=null, waiting=null, additionalProperties={}),\nname=spark-kubernetes-driver, ready=false, restartCount=0,\nstate=ContainerState(running=null,\nterminated=ContainerStateTerminated(containerID=docker:\u002F\u002Fe044d944d2ebe\ne2855cd2b993c62025d6406258ef247648a5902bf6ac09801cc, exitCode=0,\nfinishedAt=2019-08-22T14:59:08Z, message=null, reason=Completed,\nsignal=null, startedAt=2019-08-22T14:58:32Z,\nadditionalProperties={}), waiting=null, additionalProperties={}),\nadditionalProperties={})]\n\n19\u002F08\u002F22 11:59:09 INFO LoggingPodStatusWatcherImpl: Container final\nstatuses: Container name: spark-kubernetes-driver Container image:\nspark:docker Container state: Terminated Exit code: 0\n",[774],{"type":22,"tag":457,"props":775,"children":776},{"__ignoreMap":7},[777],{"type":28,"value":772},{"type":22,"tag":38,"props":779,"children":780},{},[781,783,789],{"type":28,"value":782},"To see the job result (and the whole execution) we can run a\n",{"type":22,"tag":457,"props":784,"children":786},{"className":785},[],[787],{"type":28,"value":788},"kubectl logs",{"type":28,"value":790}," passing the name of the driver pod as a parameter:",{"type":22,"tag":531,"props":792,"children":795},{"code":793,"language":534,"meta":7,"className":794},"kubectl logs $(kubectl get pods | grep 'spark-pi.*-driver')\n",[536],[796],{"type":22,"tag":457,"props":797,"children":798},{"__ignoreMap":7},[799],{"type":28,"value":793},{"type":22,"tag":38,"props":801,"children":802},{},[803],{"type":28,"value":804},"Which brings the output (omitted some entries), similar to:",{"type":22,"tag":531,"props":806,"children":808},{"code":807},"...\n19\u002F08\u002F22 14:59:08 INFO TaskSetManager: Finished task 1.0 in stage 0.0\n(TID 1) in 52 ms on 172.17.0.7 (executor 1) (2\u002F2)\n19\u002F08\u002F22 14:59:08 INFO TaskSchedulerImpl: Removed TaskSet 0.0, whose\ntasks have all completed, from pool19\u002F08\u002F22 14:59:08 INFO\nDAGScheduler: ResultStage 0 (reduce at SparkPi.scala:38) finished in\n0.957 s\n19\u002F08\u002F22 14:59:08 INFO DAGScheduler: Job 0 finished: reduce at\nSparkPi.scala:38, took 1.040608 s Pi is roughly 3.138915694578473\n19\u002F08\u002F22 14:59:08 INFO SparkUI: Stopped Spark web UI at\nhttp:\u002F\u002Fspark-pi-1566485909677-driver-svc.default.svc:4040\n19\u002F08\u002F22 14:59:08 INFO KubernetesClusterSchedulerBackend: Shutting\ndown all executors\n19\u002F08\u002F22 14:59:08 INFO\nKubernetesClusterSchedulerBackend$KubernetesDriverEndpoint: Asking\neach executor to shut down\n19\u002F08\u002F22 14:59:08 WARN ExecutorPodsWatchSnapshotSource: Kubernetes\nclient has been closed (this is expected if the application is\nshutting down.)\n19\u002F08\u002F22 14:59:08 INFO MapOutputTrackerMasterEndpoint:\nMapOutputTrackerMasterEndpoint stopped!\n19\u002F08\u002F22 14:59:08 INFO MemoryStore: MemoryStore cleared\n19\u002F08\u002F22 14:59:08 INFO BlockManager: BlockManager stopped\n19\u002F08\u002F22 14:59:08 INFO BlockManagerMaster: BlockManagerMaster stopped\n19\u002F08\u002F22 14:59:08 INFO\nOutputCommitCoordinator$OutputCommitCoordinatorEndpoint:\nOutputCommitCoordinator stopped!\n19\u002F08\u002F22 14:59:08 INFO SparkContext: Successfully stopped SparkContext\n19\u002F08\u002F22 14:59:08 INFO ShutdownHookManager: Shutdown hook called\n19\u002F08\u002F22 14:59:08 INFO ShutdownHookManager: Deleting directory\n\u002Ftmp\u002Fspark-aeadc6ba-36aa-4b7e-8c74-53aa48c3c9b2\n19\u002F08\u002F22 14:59:08 INFO ShutdownHookManager: Deleting directory\n\u002Fvar\u002Fdata\u002Fspark-084e8326-c8ce-4042-a2ed-75c1eb80414a\u002Fspark-ef8117bf-90\nd0-4a0d-9cab-f36a7bb18910\n...\n",[809],{"type":22,"tag":457,"props":810,"children":811},{"__ignoreMap":7},[812],{"type":28,"value":807},{"type":22,"tag":38,"props":814,"children":815},{},[816],{"type":28,"value":817},"The result appears in:",{"type":22,"tag":531,"props":819,"children":821},{"code":820},"19\u002F08\u002F22 14:59:08 INFO DAGScheduler: Job 0 finished: reduce at\nSparkPi.scala:38, took 1.040608 s Pi is roughly 3.138915694578473\n",[822],{"type":22,"tag":457,"props":823,"children":824},{"__ignoreMap":7},[825],{"type":28,"value":820},{"type":22,"tag":38,"props":827,"children":828},{},[829],{"type":28,"value":830},"Finally, let's delete the VM that Minikube generates, to clean up the\nenvironment (unless you want to keep playing with it):",{"type":22,"tag":531,"props":832,"children":835},{"code":833,"language":534,"meta":7,"className":834},"minikube delete\n",[536],[836],{"type":22,"tag":457,"props":837,"children":838},{"__ignoreMap":7},[839],{"type":28,"value":833},{"type":22,"tag":31,"props":841,"children":843},{"id":842},"last-words",[844],{"type":28,"value":845},"Last words",{"type":22,"tag":38,"props":847,"children":848},{},[849,851,856],{"type":28,"value":850},"I hope your curiosity got ",{"type":22,"tag":44,"props":852,"children":853},{},[854],{"type":28,"value":855},"sparked",{"type":28,"value":857}," and some ideas for further\ndevelopment have raised for your Big Data workloads. If you have any\ndoubt or suggestion, don't hesitate to share on the comment section.",{"title":7,"searchDepth":859,"depth":859,"links":860},2,[861,862,863,864,865,866],{"id":33,"depth":859,"text":36},{"id":259,"depth":859,"text":262},{"id":403,"depth":859,"text":406},{"id":544,"depth":859,"text":547},{"id":589,"depth":859,"text":592},{"id":842,"depth":859,"text":845},"markdown","content:posts:2020:05:quickstart-apache-spark-on-kubernetes.md","content","posts\u002F2020\u002F05\u002Fquickstart-apache-spark-on-kubernetes.md","posts\u002F2020\u002F05\u002Fquickstart-apache-spark-on-kubernetes","md",1778000258470]